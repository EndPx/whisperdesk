# WhisperDesk live demo console — server-side env (Next.js route handlers under src/app/api/demo/).
# Copy to .env.local (or .env) and fill in real values. NEVER commit the filled-in file.
# NOTE: web/.gitignore's `.env*` pattern also matches this .env.example — if you want the example
# tracked in git, either narrow that pattern or `git add -f web/.env.example`.

# Master switch. Every /api/demo/* route returns 503 {enabled:false} unless this is exactly "true"
# AND all vars below resolve (via their DEMO_-prefixed name or e2e fallback name).
DEMO_ENABLED=

# Escrow owner AND teeSigner key (Coston2, funded with C2FLR for gas + FTSOv2/FDC fees). Falls back
# to PRIVATE_KEY if DEMO_OWNER_PRIVATE_KEY is unset — same key scripts/e2e/ and
# script/DeployIntegration.s.sol use as PRIVATE_KEY.
DEMO_OWNER_PRIVATE_KEY=
# PRIVATE_KEY=

# Taker EVM key (Coston2, funded with C2FLR — submits the on-chain lock() tx in this console).
# Falls back to TAKER_PRIVATE_KEY.
DEMO_TAKER_PRIVATE_KEY=
# TAKER_PRIVATE_KEY=

# Maker EVM key (Coston2, funded with C2FLR for the bond deposit tx). Falls back to
# MAKER_PRIVATE_KEY.
DEMO_MAKER_PRIVATE_KEY=
# MAKER_PRIVATE_KEY=

# XRPL testnet seed for the maker account that sends the real XRP payment leg. Falls back to
# XRPL_MAKER_SEED.
DEMO_XRPL_MAKER_SEED=
# XRPL_MAKER_SEED=

# XRPL testnet classic address for the taker (receives the XRP payment; also the plaintext
# takerXrplAddress field signed into the MatchInstruction). Falls back to XRPL_TAKER_ADDRESS.
DEMO_XRPL_TAKER_ADDRESS=
# XRPL_TAKER_ADDRESS=

# Deployed DvPEscrow address on Coston2 (script/DeployIntegration.s.sol output). Falls back to
# ESCROW_ADDRESS.
DEMO_ESCROW_ADDRESS=
# ESCROW_ADDRESS=

# Optional: Coston2 JSON-RPC endpoint override. Defaults to
# https://coston2-api.flare.network/ext/C/rpc when unset.
COSTON2_RPC=
